# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com → your project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-service-role-key

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local: redis://localhost:6379
# Upstash (free cloud Redis): rediss://your-endpoint.upstash.io:6380
REDIS_URL=redis://localhost:6379

# ─── JWT (your own tokens — separate from Supabase Auth) ─────────────────────
JWT_SECRET=change_this_to_a_long_random_string_minimum_32_characters_required
JWT_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000

# ─── OpenAI (optional — enables AI code assistant) ───────────────────────────
OPENAI_API_KEY=sk-...your-key

# ─── Email / SMTP (optional — enables invite emails) ─────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=DevSpace <noreply@devspace.io>

# ─── Code execution limits ────────────────────────────────────────────────────
CODE_EXEC_TIMEOUT_MS=5000
